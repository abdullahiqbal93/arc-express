<% const ext = language === 'typescript' ? 'ts' : 'js'; -%>
import { createErrorResponse } from "#lib/services/error.<%= ext %>";
import { StatusCodes } from "http-status-codes";
<%_ if (orm === 'sequelize') { -%>
import User from "#db/models/user.<%= ext %>";
<%_ } else if (orm === 'prisma') { -%>
import prisma from "#lib/db/connect.<%= ext %>";
<%_ } else if (orm === 'drizzle') { -%>
import db from "#lib/db/connect.<%= ext %>";
import { users } from "#db/schema/index.<%= ext %>";
import { eq } from "drizzle-orm";
<%_ } -%>
<%_ if (language === 'typescript') { -%>
import type { NextFunction, Request, Response } from "express";
<%_ } -%>

/**
 * Middleware: require the logged-in user to be an admin.
 * Must be placed AFTER requireAuth.
 */
export const requireAdmin = async (req<%- language === 'typescript' ? ': Request' : '' %>, res<%- language === 'typescript' ? ': Response' : '' %>, next<%- language === 'typescript' ? ': NextFunction' : '' %>) => {
  try {
    const userId = req.userId;
    if (!userId) {
      return createErrorResponse(res, null, StatusCodes.UNAUTHORIZED, "Authentication required");
    }
<%_ if (orm === 'sequelize') { -%>
    const user = await User.findByPk(userId, { attributes: ["id", "role"] });
    if (!user || user.role !== "admin") {
<%_ } else if (orm === 'prisma') { -%>
    const user = await prisma.user.findUnique({ where: { id: userId }, select: { id: true, role: true } });
    if (!user || user.role !== "admin") {
<%_ } else { -%>
    const [user] = await db.select({ id: users.id, role: users.role }).from(users).where(eq(users.id, userId)).limit(1);
    if (!user || user.role !== "admin") {
<%_ } -%>
      return createErrorResponse(res, null, StatusCodes.FORBIDDEN, "Admin access required");
    }
    req.isAdmin = true;
    next();
  } catch {
    return createErrorResponse(res, null, StatusCodes.INTERNAL_SERVER_ERROR, "Authorization check failed");
  }
};
