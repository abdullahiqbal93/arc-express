const testState = vi.hoisted(() => {
  const users = new Map<%- language === 'typescript' ? '<number, TestUser>' : '' %>();

  const syncAliases = (user<%- language === 'typescript' ? ': TestUser' : '' %>) => {
    user.passwordHash = user.passwordHash ?? user.password_hash ?? null;
    user.password_hash = user.password_hash ?? user.passwordHash ?? null;
    user.googleId = user.googleId ?? user.google_id ?? null;
    user.google_id = user.google_id ?? user.googleId ?? null;
    user.resetPasswordToken = user.resetPasswordToken ?? user.reset_password_token ?? null;
    user.reset_password_token = user.reset_password_token ?? user.resetPasswordToken ?? null;
    user.resetPasswordExpires = user.resetPasswordExpires ?? user.reset_password_expires ?? null;
    user.reset_password_expires = user.reset_password_expires ?? user.resetPasswordExpires ?? null;
    return user;
  };

  const makeUser = (input<%- language === 'typescript' ? ': UserInput' : '' %>) => {
    const id = input.id ?? state.nextUserId++;
    const user<%- language === 'typescript' ? ': TestUser' : '' %> = {
      id,
      email: input.email,
      name: input.name,
      role: input.role ?? "user",
      status: input.status ?? "active",
      passwordHash: input.passwordHash ?? input.password_hash ?? null,
      password_hash: input.password_hash ?? input.passwordHash ?? null,
      googleId: input.googleId ?? input.google_id ?? null,
      google_id: input.google_id ?? input.googleId ?? null,
      resetPasswordToken: input.resetPasswordToken ?? input.reset_password_token ?? null,
      reset_password_token: input.reset_password_token ?? input.resetPasswordToken ?? null,
      resetPasswordExpires: input.resetPasswordExpires ?? input.reset_password_expires ?? null,
      reset_password_expires: input.reset_password_expires ?? input.resetPasswordExpires ?? null,
      save: async () => {
        users.set(id, syncAliases(user));
        return user;
      },
      destroy: async () => {
        users.delete(id);
      },
      toJSON: () => {
        const { save: _save, destroy: _destroy, toJSON: _toJSON, ...data } = syncAliases(user);
        return data;
      },
    };
    users.set(id, syncAliases(user));
    return user;
  };

  const state = {
    users,
    nextUserId: 1,
    lastResetToken: "",
    reset: () => {
      users.clear();
      state.nextUserId = 1;
      state.lastResetToken = "";
    },
    makeUser,
    findById: (id<%- language === 'typescript' ? ': number | string | undefined' : '' %>) => {
      if (!id) return null;
      return users.get(Number(id)) ?? null;
    },
    findByEmail: (email<%- language === 'typescript' ? ': string | undefined' : '' %>) => {
      if (!email) return null;
      return [...users.values()].find((user) => user.email === email) ?? null;
    },
    findByGoogleId: (googleId<%- language === 'typescript' ? ': string | undefined' : '' %>) => {
      if (!googleId) return null;
      return [...users.values()].find((user) => user.googleId === googleId || user.google_id === googleId) ?? null;
    },
    findByResetToken: (token<%- language === 'typescript' ? ': string | undefined' : '' %>) => {
      if (!token) return null;
      const now = Date.now();
      return [...users.values()].find((user) => {
        const expires = user.resetPasswordExpires ?? user.reset_password_expires;
        return (user.resetPasswordToken === token || user.reset_password_token === token) && expires && expires.getTime() > now;
      }) ?? null;
    },
  };

  return state;
});

const csrfBypass = { referer: "http://localhost/api/docs" };

