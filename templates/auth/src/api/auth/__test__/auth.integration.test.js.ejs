<%_ if (features.testing) { -%>
<% const ext = language === 'typescript' ? 'ts' : 'js'; -%>
import request from "supertest";
import { beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
<%_ if (language === 'typescript') { -%>
import type { Express } from "express";

type TestUser = {
  id: number;
  email: string;
  name: string;
  role: string;
  status: string;
  passwordHash: string | null;
  password_hash: string | null;
  googleId: string | null;
  google_id: string | null;
  resetPasswordToken: string | null;
  reset_password_token: string | null;
  resetPasswordExpires: Date | null;
  reset_password_expires: Date | null;
  save: () => Promise<TestUser>;
  destroy: () => Promise<void>;
  toJSON: () => Omit<TestUser, "save" | "destroy" | "toJSON">;
};

type UserInput = Partial<TestUser> & {
  email: string;
  name: string;
};

<%_ if (orm !== 'drizzle') { -%>
type WhereClause = {
  id?: number | string;
  email?: string;
  googleId?: string;
  google_id?: string;
  resetPasswordToken?: string;
  reset_password_token?: string;
};

type QueryShape = {
  where?: WhereClause;
  data?: Partial<TestUser>;
  select?: Record<string, boolean>;
};
<%_ } -%>

<%_ if (orm === 'drizzle') { -%>
type MockCondition =
  | { kind: "eq"; column: keyof TestUser; value: unknown }
  | { kind: "gt"; column: keyof TestUser; value: unknown }
  | { kind: "and"; conditions: MockCondition[] };
<%_ } -%>
<%_ } -%>

