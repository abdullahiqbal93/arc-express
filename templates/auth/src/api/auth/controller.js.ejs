export const googleCallback = async <%- handlerArgs %> => {
  try {
    const { code } = req.body;
    if (!code) return createErrorResponse(res, null, StatusCodes.BAD_REQUEST, "Authorization code is required");

    const tokenRes = await fetch("https://oauth2.googleapis.com/token", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        code,
        client_id: env.GOOGLE_CLIENT_ID,
        client_secret: env.GOOGLE_CLIENT_SECRET,
        redirect_uri: env.GOOGLE_CALLBACK_URL,
        grant_type: "authorization_code",
      }),
    });
    const tokenData = await tokenRes.json();
    if (tokenData.error) {
      return createErrorResponse(res, null, StatusCodes.BAD_REQUEST, `Google token error: ${tokenData.error_description || tokenData.error}`);
    }

    const userInfoRes = await fetch("https://www.googleapis.com/oauth2/v2/userinfo", {
      headers: { Authorization: `Bearer ${tokenData.access_token}` },
    });
