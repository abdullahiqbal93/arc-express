    const updated = await db.select().from(users).where(eq(users.id, <%- userIdExpr %>)).limit(1);
<%_ } else { -%>
    const updated = await db.update(users).set({ ...(name && { name }), ...(email && { email }) }).where(eq(users.id, <%- userIdExpr %>)).returning();
<%_ } -%>
    createSuccessResponse(res, updated[0], StatusCodes.OK, "Profile updated");
<%_ } -%>
  } catch (e) {
    createErrorResponse(res, handleError(e), StatusCodes.INTERNAL_SERVER_ERROR);
  }
};

// ── Change Password ───────────────────────────────────────────
export const changePassword = async <%- authHandlerArgs %> => {
  try {
    <%- findById('user', userIdExpr) %>
    if (!user) return createErrorResponse(res, null, StatusCodes.NOT_FOUND, "User not found");

    const { current_password = "", new_password } = req.body;
<%_ if (orm === 'sequelize') { -%>
    const hash = user.password_hash;
<%_ } else { -%>
    const hash = user.passwordHash;
<%_ } -%>

    if (hash) {
      if (!current_password.trim()) return createErrorResponse(res, null, StatusCodes.BAD_REQUEST, "Current password is required");
      const valid = await bcrypt.compare(current_password, hash);
      if (!valid) return createErrorResponse(res, null, StatusCodes.BAD_REQUEST, "Current password is incorrect");
    }

    const salt = await bcrypt.genSalt(env.SALT_FACTOR);
    const newHash = await bcrypt.hash(new_password, salt);

<%_ if (orm === 'sequelize') { -%>
    user.password_hash = newHash;
    await user.save();
<%_ } else if (orm === 'prisma') { -%>
    await prisma.user.update({ where: { id: <%- userIdExpr %> }, data: { passwordHash: newHash } });
<%_ } else { -%>
    await db.update(users).set({ passwordHash: newHash }).where(eq(users.id, <%- userIdExpr %>));
<%_ } -%>

    createSuccessResponse(res, null, StatusCodes.OK, "Password changed");
  } catch (e) {
    createErrorResponse(res, handleError(e), StatusCodes.INTERNAL_SERVER_ERROR);
  }
};

