  if (orm === 'sequelize') return `const ${varName} = await User.findByPk(${id});`;
  if (orm === 'prisma') return `const ${varName} = await prisma.user.findUnique({ where: { id: ${id} } });`;
  if (orm === 'drizzle') return `const [${varName}] = await db.select().from(users).where(eq(users.id, ${id})).limit(1);`;
