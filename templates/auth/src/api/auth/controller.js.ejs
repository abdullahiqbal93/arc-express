// Helper to get a user from DB based on ORM
const findByEmail = (varName, email) => {
  if (orm === 'sequelize') return `const ${varName} = await User.findOne({ where: { email: ${email} } });`;
  if (orm === 'prisma') return `const ${varName} = await prisma.user.findUnique({ where: { email: ${email} } });`;
  if (orm === 'drizzle') return `const [${varName}] = await db.select().from(users).where(eq(users.email, ${email})).limit(1);`;
};
