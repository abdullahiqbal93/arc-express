      const taken = await User.findOne({ where: { email, id: { [Op.ne]: user.id } } });
      if (taken) return createErrorResponse(res, null, StatusCodes.CONFLICT, "Email already in use");
      user.email = email;
    }
    if (name) user.name = name;
    await user.save();
    createSuccessResponse(res, { id: user.id, email: user.email, name: user.name }, StatusCodes.OK, "Profile updated");
<%_ } else if (orm === 'prisma') { -%>
    if (email && email !== user.email) {
      const taken = await prisma.user.findFirst({ where: { email, NOT: { id: user.id } } });
      if (taken) return createErrorResponse(res, null, StatusCodes.CONFLICT, "Email already in use");
    }
    const updated = await prisma.user.update({ where: { id: <%- userIdExpr %> }, data: { ...(name && { name }), ...(email && { email }) } });
    createSuccessResponse(res, { id: updated.id, email: updated.email, name: updated.name }, StatusCodes.OK, "Profile updated");
<%_ } else { -%>
