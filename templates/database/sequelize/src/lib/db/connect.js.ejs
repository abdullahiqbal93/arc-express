<% const ext = language === 'typescript' ? 'ts' : 'js'; -%>
import { Sequelize } from "sequelize";
import { env } from "#lib/config.<%= ext %>";
import { mainLogger } from "#lib/logger/winston.<%= ext %>";

const sequelize = new Sequelize(env.DATABASE_URL, {
  dialect: "<%= database === 'mysql' ? 'mysql' : 'postgres' %>",
  logging: process.env.LOG_SQL === "true"
    ? (msg<%- language === 'typescript' ? ': string' : '' %>) => mainLogger.debug(msg)
    : false,
  define: {
    underscored: true,
    timestamps: true,
  },
});

export const connectDB = async () => {
  try {
    await sequelize.authenticate();
    mainLogger.info("Database connected successfully.");
    return sequelize;
  } catch (error) {
    mainLogger.error("Database connection failed:", error);
    throw error;
  }
};

export default sequelize;
