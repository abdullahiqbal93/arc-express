<% const ext = language === 'typescript' ? 'ts' : 'js'; -%>
/**
 * Central model registry.
 * Import and re-export all models here, then define associations.
 */
<%_ if (features.auth) { -%>
import User from "./user.<%= ext %>";
<%_ } -%>
<%_ if (features.audit) { -%>
import AuditLog from "./audit-log.<%= ext %>";
<%_ } -%>

export {
<%_ if (features.auth) { -%>
  User,
<%_ } -%>
<%_ if (features.audit) { -%>
  AuditLog,
<%_ } -%>
};

