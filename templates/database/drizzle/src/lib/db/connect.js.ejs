<% const ext = language === 'typescript' ? 'ts' : 'js'; -%>
<%_ if (database === 'postgresql') { -%>
import { drizzle } from "drizzle-orm/postgres-js";
import postgres from "postgres";
<%_ } else { -%>
import { drizzle } from "drizzle-orm/mysql2";
import mysql from "mysql2/promise";
<%_ } -%>
import { env } from "#lib/config.<%= ext %>";
import { mainLogger } from "#lib/logger/winston.<%= ext %>";

<%_ if (database === 'postgresql') { -%>
export const client = postgres(env.DATABASE_URL);
const db = drizzle(client);
<%_ } else { -%>
export const pool = mysql.createPool(env.DATABASE_URL);
const db = drizzle(pool);
<%_ } -%>

export const connectDB = async () => {
  try {
    mainLogger.info("Database connected successfully.");
    return db;
  } catch (error) {
    mainLogger.error("Database connection failed:", error);
    throw error;
  }
};

export default db;
