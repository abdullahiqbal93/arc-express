<% const ext = language === 'typescript' ? 'ts' : 'js'; -%>
import { GenericContainer } from "testcontainers";
<%_ if (language === 'typescript') { -%>
import type { StartedTestContainer } from "testcontainers";
<%_ } -%>
import { mainLogger } from "#lib/logger/winston.<%= ext %>";
<%_ if (orm === 'sequelize') { -%>
import { Sequelize } from "sequelize";
<%_ } else if (orm === 'prisma') { -%>
import { PrismaClient } from "@prisma/client";
<%_ } else if (orm === 'drizzle') { -%>
<%_ if (database === 'postgresql') { -%>
import { drizzle } from "drizzle-orm/postgres-js";
import postgres from "postgres";
<%_ if (language === 'typescript') { -%>
import type { Sql } from "postgres";
<%_ } -%>
<%_ } else { -%>
import { drizzle } from "drizzle-orm/mysql2";
import mysql from "mysql2/promise";
<%_ } -%>
<%_ } -%>

let container<%- language === 'typescript' ? ': StartedTestContainer | undefined' : '' %>;
<%_ if (orm === 'sequelize') { -%>
let testDb<%- language === 'typescript' ? ': Sequelize | undefined' : '' %>;
<%_ } else if (orm === 'prisma') { -%>
let testDb<%- language === 'typescript' ? ': PrismaClient | undefined' : '' %>;
<%_ } else if (orm === 'drizzle') { -%>
let testDb<%- language === 'typescript' ? ': unknown' : '' %>;
let client<%- language === 'typescript' ? (database === 'postgresql' ? ': Sql | undefined' : ': ReturnType<typeof mysql.createPool> | undefined') : '' %>;
<%_ } -%>

/**
 * Start a <%= database %> testcontainer and return a <%= orm %> instance.
 */
export const setupTestDB = async () => {
  try {
<%_ if (database === 'postgresql') { -%>
    container = await new GenericContainer("postgres:16-alpine")
      .withExposedPorts(5432)
      .withEnvironment({
        POSTGRES_USER: "test",
        POSTGRES_PASSWORD: "test",
        POSTGRES_DB: "test_db",
      })
      .withDefaultLogDriver()
      .start();

    const host = container.getHost();
    const port = container.getMappedPort(5432);
    const url = `postgres://test:test@${host}:${port}/test_db`;
<%_ } else { -%>
    container = await new GenericContainer("mysql:8.0")
      .withExposedPorts(3306)
      .withEnvironment({
        MYSQL_ROOT_PASSWORD: "test",
        MYSQL_DATABASE: "test_db",
      })
      .withDefaultLogDriver()
      .start();

    const host = container.getHost();
    const port = container.getMappedPort(3306);
    const url = `mysql://root:test@${host}:${port}/test_db`;
<%_ } -%>

<%_ if (orm === 'sequelize') { -%>
    testDb = new Sequelize(url, {
      dialect: "<%= database === 'mysql' ? 'mysql' : 'postgres' %>",
      logging: false,
      define: { underscored: true, timestamps: true },
    });
    await testDb.authenticate();
<%_ } else if (orm === 'prisma') { -%>
    testDb = new PrismaClient({
      datasources: { db: { url } },
      log: [],
    });
    await testDb.$connect();
<%_ } else if (orm === 'drizzle') { -%>
<%_ if (database === 'postgresql') { -%>
    client = postgres(url);
    testDb = drizzle(client);
    await client`SELECT 1`; // Test connection
<%_ } else { -%>
    client = await mysql.createPool(url);
    testDb = drizzle(client);
    await client.query("SELECT 1"); // Test connection
<%_ } -%>
<%_ } -%>

    mainLogger.info("Test database connected successfully.");
    return testDb;
  } catch (error) {
    mainLogger.error("Error setting up test database:", error);
    throw error;
  }
};

/**
 * Tear down container and close connection.
 */
export const teardownTestDB = async () => {
<%_ if (orm === 'sequelize') { -%>
  if (testDb) await testDb.close();
<%_ } else if (orm === 'prisma') { -%>
  if (testDb) await testDb.$disconnect();
<%_ } else if (orm === 'drizzle') { -%>
<%_ if (database === 'postgresql') { -%>
  if (client) await client.end();
<%_ } else { -%>
  if (client) await client.end();
<%_ } -%>
<%_ } -%>
  if (container) await container.stop();
};

export { testDb };
