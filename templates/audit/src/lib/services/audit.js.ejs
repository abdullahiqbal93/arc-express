<% const ext = language === 'typescript' ? 'ts' : 'js'; -%>
<%_ if (orm === 'prisma') { -%>
import prisma from "#lib/db/connect.<%= ext %>";
<%_ } else if (orm === 'drizzle') { -%>
import db from "#lib/db/connect.<%= ext %>";
<%_ } -%>
import { mainLogger } from "#lib/logger/winston.<%= ext %>";
<%_ if (language === 'typescript') { -%>
import type { Request } from "express";

type JsonValue = string | number | boolean | null | JsonValue[] | { [key: string]: JsonValue };

type AuditLogOptions = {
  userId: number | null;
  action: string;
  entityType: string;
  entityId?: number | string | null;
  metadata?: JsonValue;
  req?: Request | null;
};
<%_ } -%>

/**
 * Write an audit log entry.
 * @param {object} opts
 * @param {number|null} opts.userId
 * @param {string} opts.action  - e.g. "login", "create", "update", "delete"
 * @param {string} opts.entityType - e.g. "user", "transaction"
 * @param {number|null} opts.entityId
 * @param {object|null} opts.metadata
 * @param {import("express").Request} [opts.req]
 */
export const writeAuditLog = async ({ userId, action, entityType, entityId = null, metadata = null, req = null }<%- language === 'typescript' ? ': AuditLogOptions' : '' %>) => {
  try {
    const details = {
      metadata,
      ip: req?.ip || (Array.isArray(req?.headers?.["x-forwarded-for"]) ? req?.headers?.["x-forwarded-for"][0] : req?.headers?.["x-forwarded-for"]) || null,
      userAgent: req?.headers?.["user-agent"] || null,
    };
<%_ if (orm === 'sequelize') { -%>
    await (await import("#db/models/index.<%= ext %>")).AuditLog.create({
      userId: userId,
      action,
      entityType: entityType,
      entityId: entityId ? String(entityId) : null,
      metadata: metadata,
      ip: details.ip,
      userAgent: details.userAgent,
    });
<%_ } else if (orm === 'prisma') { -%>
    await prisma.auditLog.create({
      data: {
        userId, action, entityType,
        entityId: entityId ? String(entityId) : null,
        metadata: metadata ? JSON.parse(JSON.stringify(metadata)) : null,
        ip: details.ip,
        userAgent: details.userAgent,
      },
    });
<%_ } else if (orm === 'drizzle') { -%>
    const { auditLogs } = await import("#db/schema/index.<%= ext %>");
    await db.insert(auditLogs).values({
      userId, action, entityType,
      entityId: entityId ? String(entityId) : null,
      metadata,
      ip: details.ip,
      userAgent: details.userAgent,
    });
<%_ } -%>
    mainLogger.info(`AUDIT: ${action} on ${entityType}:${entityId} by user ${userId}`, details);
  } catch (error) {
    // Never let audit logging crash the request
    mainLogger.error("Audit log write failed:", error);
  }
};
