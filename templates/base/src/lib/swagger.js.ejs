<% const ext = language === 'typescript' ? 'ts' : 'js'; -%>
import swaggerJsdoc from "swagger-jsdoc";
import swaggerUi from "swagger-ui-express";
<%_ if (language === 'typescript') { -%>
import type { Application } from "express";
<%_ } -%>
import { env } from "./config.<%= ext %>";

const options = {
  definition: {
    openapi: "3.0.0",
    info: {
      title: "API Documentation",
      version: env.VERSION,
      description: "API documentation automatically generated by create-arc-express",
    },
    servers: [
      {
        url: env.API_BASE_URL,
        description: `${env.NODE_ENV} server`,
      },
    ],
    components: {
      securitySchemes: {
<%_ if (features.auth && authStrategy === 'jwt') { -%>
        bearerAuth: {
          type: "http",
          scheme: "bearer",
          bearerFormat: "JWT",
        },
<%_ } else if (features.auth && authStrategy === 'session') { -%>
        cookieAuth: {
          type: "apiKey",
          in: "cookie",
          name: "connect.sid",
        },
<%_ } -%>
<%_ if (features.csrf) { -%>
        csrfAuth: {
          type: "apiKey",
          in: "header",
          name: "x-csrf-token",
          description: "CSRF token required for state-changing requests. Fetch from GET /api/csrf-token first.",
        },
<%_ } -%>
      },
    },
<%_ if (features.auth || features.csrf) { -%>
    security: [
      {
<%_ if (features.auth && authStrategy === 'jwt') { -%>
        bearerAuth: [],
<%_ } else if (features.auth) { -%>
        cookieAuth: [],
<%_ } -%>
<%_ if (features.csrf) { -%>
        csrfAuth: [],
<%_ } -%>
      }
    ],
<%_ } -%>
  },
  // Look for Swagger comments in all route files and server entry
  apis: ["./src/api/**/*.js", "./src/api/**/*.ts", "./src/lib/server.js", "./src/lib/server.ts"],
};

const swaggerSpec = swaggerJsdoc(options);

export const setupSwagger = (app<%- language === 'typescript' ? ': Application' : '' %>) => {
  app.use("/api/docs", swaggerUi.serve, swaggerUi.setup(swaggerSpec, {
    customSiteTitle: "API Documentation",
<%_ if (features.csrf) { -%>
    customJsStr: `
      // ── Auto CSRF for Swagger UI ─────────────────────────────────
      // Monkey-patches fetch so every POST/PUT/PATCH/DELETE request
      // automatically gets a fresh CSRF token + the __csrf cookie.
      (function() {
        const _fetch = window.fetch.bind(window);
        const MUTATING = new Set(['POST','PUT','PATCH','DELETE']);
        let _token = null;

        async function refreshToken() {
          try {
            const r = await _fetch(
              window.location.origin + '/api/' + '${env.VERSION}' + '/csrf-token',
              { credentials: 'include' }
            );
            const json = await r.json();
            _token = json?.data?.csrfToken || null;
          } catch(e) { _token = null; }
        }

        // Pre-fetch a token as soon as the page loads
        refreshToken();

        window.fetch = async function(url, opts) {
          opts = opts || {};
          const method = (opts.method || 'GET').toUpperCase();

          // Skip intercepting the csrf-token endpoint itself
          if (typeof url === 'string' && url.includes('csrf-token')) {
            return _fetch(url, Object.assign(opts, { credentials: 'include' }));
          }

          if (MUTATING.has(method)) {
            // Always get a fresh token right before the request
            await refreshToken();
            if (_token) {
              opts.headers = opts.headers || {};
              if (opts.headers instanceof Headers) {
                opts.headers.set('x-csrf-token', _token);
              } else {
                opts.headers['x-csrf-token'] = _token;
              }
            }
            // Ensure cookies (__csrf) are sent
            opts.credentials = 'include';
          }

          return _fetch(url, opts);
        };
      })();
    `,
<%_ } -%>
  }));
};
